# =========================
# ML Models
# Ignore generated/trained models
# =========================

models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth

# Keep the models folder
!models/.gitkeep

# =========================
# Generated Output
# =========================

output/*
!output/.gitkeep

# =========================
# GeoIP Databases
# Large downloaded databases
# =========================

geoip/*.mmdb
geoip/*.dat
geoip/*.csv
geoip/*.zip
geoip/*.tar.gz

# Keep the geoip folder
!geoip/.gitkeep

# =========================
# Generated Data
# Uncomment these if you do NOT
# want generated datasets in Git
# =========================

# data/raw/*
# !data/raw/.gitkeep

# data/processed/*
# !data/processed/.gitkeep

# =========================
# PyVis / Temporary Files
# =========================

*.html
pyvis_output/

# =========================
# Local Configuration
# =========================

config.local.*